<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Page Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/market_price_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

        <!-- Crop Name Input -->
        <EditText
            android:id="@+id/etCropSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_crop_name"
            android:padding="12dp"
            android:textSize="16sp"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapWords" />

        <!-- Mic Button -->
        <ImageButton
            android:id="@+id/btnVoiceSearch"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:backgroundTint="#4CAF50"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@android:color/white"
            android:contentDescription="Voice Search" />

        <!-- Market Price Button -->
        <Button
            android:id="@+id/btnFetchPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_market_price"
            android:layout_marginTop="16dp"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <!-- Language Selection Spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_language"
            android:layout_marginTop="20dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="start" />

        <Spinner
            android:id="@+id/spinnerLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:spinnerMode="dropdown" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressMarket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:layout_gravity="center" />

        <!-- AI Result -->
        <TextView
            android:id="@+id/tvMarketResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/result_will_appear"
            android:textColor="#000000"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="10dp"
            android:layout_marginTop="20dp"
            android:background="#E8F5E9" />

        <!-- Optional: Back Button to Dashboard -->


    </LinearLayout>
</ScrollView>
