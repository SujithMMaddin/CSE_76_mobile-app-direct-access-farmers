<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F9F9F9">

    <TextView
        android:id="@+id/tvCropTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/crop_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvEndTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bidding_ends"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvWinnerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/current_highest"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnConfirmWinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_winner"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvNoBids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_bids_yet"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_margin="16dp" />
</LinearLayout>
