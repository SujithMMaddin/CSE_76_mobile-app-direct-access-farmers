<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Crop Image -->
        <ImageView
            android:id="@+id/imageCrop"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="12dp"
            android:background="@drawable/image_border" />

        <!-- Crop Info -->
        <TextView
            android:id="@+id/tvCropName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crop Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Base Price: ₹"
            android:textSize="18sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity:"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location:"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvHarvestDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Harvest Date:"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvBiddingEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bidding Ends:"
            android:layout_marginBottom="8dp" />

        <!-- Countdown Timer -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time left: --"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Farmer Info -->
        <TextView
            android:id="@+id/tvFarmerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Farmer: -"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvFarmerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Phone: -"
            android:textSize="16sp"
            android:textColor="#00796B"
            android:layout_marginBottom="8dp" />

        <!-- Highest Bid -->
        <TextView
            android:id="@+id/tvWinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Highest Bid: ₹0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvWinnerMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏆 You are the winner of this crop!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:background="#E8F5E9"
            android:padding="10dp"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />



        <!-- 📞 Call Farmer -->
        <Button
            android:id="@+id/btnCallFarmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Call Farmer"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp" />

        <!-- 💳 Pay Now (Shown only to winner) -->
        <Button
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💳 Pay Now"
            android:backgroundTint="#4CAF50"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:layout_marginTop="12dp" />

        <!-- Customer Bid Input -->
        <EditText
            android:id="@+id/etBidAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your bid (₹)"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPlaceBid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Place Bid"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp" />

        <!-- Recycler for All Bids -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All Bids:"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
