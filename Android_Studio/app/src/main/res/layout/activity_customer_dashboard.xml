<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#F5F5F5">

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/available_crops"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="12dp"
        android:background="#4CAF50"
        android:textColor="@android:color/white"
        android:gravity="center"/>

    <!-- Filter: Location autocomplete -->
    <AutoCompleteTextView
        android:id="@+id/actvLocation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:hint="Filter by location"
        android:padding="10dp"
        android:background="@drawable/edittext_border"
        android:inputType="textCapWords"/>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:layout_gravity="center"/>

    <!-- Crops list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCrops"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"/>

    <!-- Empty message -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_bids_yet"
        android:gravity="center"
        android:visibility="gone"
        android:textColor="#888888"
        android:layout_marginTop="8dp"/>

</LinearLayout>
