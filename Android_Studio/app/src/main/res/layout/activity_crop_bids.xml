<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F9F9"
    android:padding="16dp"
    tools:context=".CropBidsActivity">

    <!-- Header Section -->
    <TextView
        android:id="@+id/tvCropName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crop: -"
        android:textColor="#4CAF50"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Base Price: ₹-"
        android:textColor="#000000"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvBiddingEnd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bidding Ends: -"
        android:textColor="#757575"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginBottom="8dp" />

    <!-- Average and AI Suggestion -->
    <TextView
        android:id="@+id/tvAvgBid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Average bid: -"
        android:textColor="#FF9800"
        android:textSize="15sp"
        android:textStyle="italic"
        android:gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <!-- Bids List -->
    <TextView
        android:id="@+id/tvNoBids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No bids yet. Be the first to bid!"
        android:textSize="15sp"
        android:textColor="#757575"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBids"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:layout_marginBottom="12dp" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBids"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminate="true" />

    <!-- Place Bid Button -->
    <Button
        android:id="@+id/btnPlaceBid"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="💰 Place a Bid"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

</LinearLayout>
